# dev
BACKEND_PORT=3000
FRONTEND_PORT=5173

# prod
HTTP_PORT=80
# name of the external Docker network your reverse proxy (Traefik,
# nginx-proxy-manager, another Caddy, ...) is on. Must already exist —
# create it once with: docker network create proxy
PROXY_NETWORK=proxy

# feature flags
# one-off backfill endpoint (POST /api/import/legacy-categorize) that applies
# categories from All-Accounts.csv-shaped exports onto matching, still-
# uncategorized transactions. Off by default.
ENABLE_LEGACY_CATEGORY_IMPORT=false
