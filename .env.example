# dev
BACKEND_PORT=3000
FRONTEND_PORT=5173

# prod
HTTP_PORT=80

# feature flags
# one-off backfill endpoint (POST /api/import/legacy-categorize) that applies
# categories from All-Accounts.csv-shaped exports onto matching, still-
# uncategorized transactions. Off by default.
ENABLE_LEGACY_CATEGORY_IMPORT=false

# auth (optional — off by default, meant for anyone relying only on
# network-level access control like a VPN; see README "Auth" section)
#
# bcrypt hash of the login password. Leave empty to disable login entirely.
# Generate one with:
#   docker compose -f docker-compose.prod.yml run --rm backend node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" 'your-password'
AUTH_PASSWORD_HASH=
# 32-byte hex key used to encrypt the session cookie. Required once
# AUTH_PASSWORD_HASH is set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=
# set to true only once a real TLS-terminating proxy sits in front of this
# app — the bundled prod Caddyfile serves plain HTTP by default, and a
# "secure" cookie is silently dropped by the browser over plain HTTP
COOKIE_SECURE=false
